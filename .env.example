# Generator LLM (default non-Claude so generator != validator family). ONE of these boots v1.
GOOGLE_API_KEY=          # gemini-3-pro generator (default)
OPENAI_API_KEY=          # gpt codex generator (alt)
ANTHROPIC_API_KEY=       # claude generator (alt) / optional 2nd-family cross-check

# Which provider generates. Values: google | openai | anthropic
PAPER2PROTOCOL_GENERATOR=google

# Optional: a DIFFERENT family for the extraction cross-check + optional critic.
# Leave blank to skip (degrades gracefully; single-key v1 still runs).
PAPER2PROTOCOL_CROSSCHECK=
